---
import logoImage from '../assets/images/logo.png';

const navLinks = [
  { href: '/about', labelJa: '私たちについて',labelEN: 'ABOUT', isAccent: false },
  { href: '/business', labelJa: '事業内容',labelEN: 'BUSINESS', isAccent: false},
  { href: '/recruit', labelJa: '採用情報', labelEN: 'RECRUIT', isAccent: false },
  { href: '/contact', labelJa: 'お問い合わせ', labelEN: 'CONTACT', isAccent: true },
]
---
<header class="header">
  <div class="inner">
    <a href="/" class="logo" data-astro-prefetch>
      <div class="icon">
        <img class="image" src={logoImage.src} alt="" width="32" height="32" />
      </div>
      <span class="text">Universe</span>
    </a>
    <nav class="navigation">
      <ul class="list">
        {navLinks.map((link) => (
          <li class="item">
            <a class:list={['link', { 'link-accent': link.isAccent, 'underline': !link.isAccent }]} href={link.href} data-astro-prefetch>
              <span class="link-ja">{link.labelJa}</span>
              <span class="link-en">{link.labelEN}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <button class="hamburger" type="button" aria-expanded="false" aria-label="メニューを開く">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>
</header>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .header {
    position: fixed;
    top: 20px;
    left: 0;
    width: 100%;
    z-index: $z-header;
    padding: 0 20px;
    color: $color-text-light;
  }

  .header .inner {
    @include flex-between;
    max-width: $container-width;
    margin: 0 auto;
    padding: 8px 30px 8px 25px;
    border-radius: 50px;
    background: transparent;
    transition: background 0.3s;

    @include reduced-motion {
      transition: none;
    }
  }

  .header .logo {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .header .icon {
    width: 32px;
    height: 32px;
  }

  .header .logo .image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .header .text {
    letter-spacing: 2px;
  }

  .header .list {
    display: flex;
    align-items: center;
    gap: 15px;

    @include sp {
      flex-direction: column;
      align-items: center;
      gap: 40px;
    }
  }

  .header .link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 10px;
    border: 1px solid transparent;

    @include sp {
      font-size: 1.25rem;
    }
  }

  .header .link-ja {
    font-size: 0.8rem;
  }

  .header .link-en {
    font-size: 0.5rem;
  }

  .header .link-accent {
    padding: 4px 24px;
    border: 1px solid $color-accent;
    border-radius: 20px;
    background: $color-accent;
    color: $color-text;
    transition: opacity 0.6s;

    @include reduced-motion {
      transition: none;
    }

    &:hover {
      opacity: 0.5;
    }
  }

  .header.is-scrolled .inner {
    background: $color-primary;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: $z-header + 1;

    @include sp {
      display: flex;
    }
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background: $color-text-light;
    transition: transform 0.3s, opacity 0.3s;

    @include reduced-motion {
      transition: none;
    }
  }

  .hamburger.is-open .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .hamburger.is-open .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .hamburger.is-open .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .navigation {
    @include sp {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      background: $color-primary;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
    }
  }

  .navigation.is-open {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s, visibility 0.3s;

    @include reduced-motion {
      transition: none;
    }
  }

  .navigation.is-open {
    opacity: 1;
    visibility: visible;
  }

</style>

<script>
  const header = document.querySelector('.header');
  const hamburger = document.querySelector('.hamburger');
  const navigation = document.querySelector('.navigation');

  if (header) {
    const checkScroll = () => {
      if(window.scrollY > 50) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    };

    checkScroll();
    window.addEventListener('scroll', checkScroll);
  }

  // ハンバーガーメニュー
  if (hamburger && navigation) {
    hamburger.addEventListener('click', () => {
      const isOpen = hamburger.classList.contains('is-open');

      hamburger.classList.toggle('is-open');
      navigation.classList.toggle('is-open');

      hamburger.setAttribute('aria-expanded', String(!isOpen));
      hamburger.setAttribute('aria-label', isOpen ? 'メニューを開く' : 'メニューを閉じる');
    });

    navigation.querySelectorAll('.link').forEach((link) => {
      link.addEventListener('click', () => {
        hamburger.classList.remove('is-open');
        navigation.classList.remove('is-open');
        hamburger.setAttribute('aria-expanded', 'false');
        hamburger.setAttribute('aria-label', 'メニューを開く');
      });
    });
   }
</script>