---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { Image } from 'astro:assets';
import { businesses } from '../data/businesses';
---

<BaseLayout
  title="事業内容 | 株式会社Universe"
  description="株式会社Universeの事業内容をご紹介します。営業代行・コンサルティング・広告マーケティング・人材育成の4事業を展開しています。"
>
  <section class="business-page">
    <div class="inner">

      <div class="business-header fade-in">
        <SectionTitle titleJa="事業内容" titleEn="BUSINESS" />
      </div>

      <div class="business-layout">

        <!-- 左ナビ -->
        <nav class="business-nav" aria-label="事業一覧">
          <ul class="business-nav-list">
            {businesses.map((business, index) => (
              <li class="business-nav-item">
                <button
                  class:list={['business-nav-btn', { 'is-active': index === 0 }]}
                  data-index={index}
                  type="button"
                  aria-selected={index === 0 ? 'true' : 'false'}
                >
                  <span class="business-nav-num">{business.number}</span>
                  <span class="business-nav-ja">{business.titleJa}</span>
                </button>
              </li>
            ))}
          </ul>
        </nav>

        <!-- 右コンテンツ -->
        <div class="business-contents">
          {businesses.map((business, index) => (
            <article
              class:list={['business-content', { 'is-active': index === 0 }]}
              data-index={index}
              id={business.id}
              aria-hidden={index !== 0 ? 'true' : 'false'}
            >
              <figure class="business-content-image">
                <Image
                  src={business.image}
                  alt={business.titleJa}
                  widths={[640, 960, 1280]}
                  sizes="(max-width: 768px) 100vw, 60vw"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </figure>
              <div class="business-content-body">
                <span class="business-content-num">{business.number}</span>
                <span class="business-content-en">{business.titleEn}</span>
                <h2 class="business-content-ja">{business.titleJa}</h2>
                <p class="business-content-catch">{business.catchphrase}</p>
                <div class="business-content-divider" aria-hidden="true"></div>
                {business.detail.map((text) => (
                  <p class="business-content-text">{text}</p>
                ))}
              </div>
            </article>
          ))}
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .business-page {
    padding: 120px 0 160px;

    @include sp {
      padding: 80px 0 100px;
    }
  }

  .business-header {
    // フェードイン用
  }

  .business-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 48px;
    align-items: start;
    margin-top: 56px;

    @include sp {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  // ── 左ナビ ──────────────────────────────────────────────────

  .business-nav {
    position: sticky;
    top: 120px; // ヘッダー高さ + 余白

    @include sp {
      position: static;
      border-bottom: 0.5px solid rgba($color-primary, 0.12);
    }
  }

  .business-nav-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;

    @include sp {
      flex-direction: row;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }
    }
  }

  .business-nav-item {
    border-top: 0.5px solid rgba($color-primary, 0.12);

    &:last-child {
      border-bottom: 0.5px solid rgba($color-primary, 0.12);
    }

    @include sp {
      border: none;
      flex-shrink: 0;
    }
  }

  .business-nav-btn {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    padding: 18px 16px;
    background: none;
    border: none;
    border-left: 2px solid transparent;
    cursor: pointer;
    text-align: left;
    transition: background 0.25s ease, border-color 0.25s ease;

    &:hover {
      background: rgba($color-primary, 0.03);
    }

    &.is-active {
      border-left-color: $color-accent;
      background: rgba($color-accent, 0.04);

      .business-nav-num {
        color: $color-accent;
      }

      .business-nav-ja {
        color: $color-primary;
      }
    }

    @include reduced-motion {
      transition: none;
    }

    @include sp {
      padding: 12px 16px;
      border-left: none;
      border-bottom: 2px solid transparent;
      flex-direction: row;
      align-items: center;
      gap: 8px;
      white-space: nowrap;

      &.is-active {
        border-left-color: transparent;
        border-bottom-color: $color-accent;
        background: transparent;
      }
    }
  }

  .business-nav-num {
    font-size: $font-size-xs;
    letter-spacing: 0.15em;
    color: $color-accent;
    transition: color 0.25s ease;

    @include reduced-motion {
      transition: none;
    }
  }

  .business-nav-ja {
    font-size: $font-size-sm;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: rgba($color-primary, 0.45);
    transition: color 0.25s ease;

    @include reduced-motion {
      transition: none;
    }
  }

  // ── 右コンテンツ ────────────────────────────────────────────

  .business-contents {
    position: relative;
    min-height: 400px;
  }

  .business-content {
    display: none;

    &.is-active {
      display: block;
      animation: contentFadeIn 0.4s ease forwards;

      @include reduced-motion {
        animation: none;
      }
    }
  }

  @keyframes contentFadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .business-content-image {
    width: 100%;
    aspect-ratio: 16 / 7;
    overflow: hidden;
    border-radius: 4px;

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    @include sp {
      aspect-ratio: 4 / 3;
    }
  }

  .business-content-body {
    margin-top: 32px;

    @include sp {
      margin-top: 24px;
    }
  }

  .business-content-num {
    display: block;
    font-size: $font-size-xs;
    letter-spacing: 0.15em;
    color: $color-accent;
  }

  .business-content-en {
    display: block;
    margin-top: 4px;
    font-size: $font-size-xs;
    letter-spacing: 0.2em;
    color: rgba($color-primary, 0.4);
  }

  .business-content-ja {
    margin-top: 8px;
    font-size: $font-size-3xl;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: $color-primary;
    line-height: 1.3;

    @include sp {
      font-size: $font-size-xl;
    }
  }

  .business-content-catch {
    margin-top: 12px;
    font-size: $font-size-base;
    font-weight: 500;
    color: rgba($color-primary, 0.6);
    letter-spacing: 0.05em;
    line-height: 1.6;

    @include sp {
      font-size: $font-size-sm;
    }
  }

  .business-content-divider {
    width: 32px;
    height: 1px;
    background: $color-accent;
    margin-top: 24px;
  }

  .business-content-text {
    margin-top: 16px;
    font-size: $font-size-sm;
    line-height: 2;
    letter-spacing: 0.06em;
    color: rgba($color-primary, 0.65);

    @include sp {
      font-size: $font-size-xs;
    }
  }
</style>

<script>
  const navBtns = document.querySelectorAll<HTMLElement>('.business-nav-btn');
  const contents = document.querySelectorAll<HTMLElement>('.business-content');

  const switchBusiness = (index: number) => {
    navBtns.forEach((btn, i) => {
      btn.classList.toggle('is-active', i === index);
      btn.setAttribute('aria-selected', String(i === index));
    });

    contents.forEach((content, i) => {
      content.classList.toggle('is-active', i === index);
      content.setAttribute('aria-hidden', String(i !== index));
    });
  };

  navBtns.forEach((btn, index) => {
    btn.addEventListener('click', () => switchBusiness(index));
  });

  // URLハッシュで初期表示を切り替え（トップページのリンクから飛んできた場合）
  const hash = window.location.hash.replace('#', '');
  if (hash) {
    const { businesses } = await import('../data/businesses');
    const targetIndex = businesses.findIndex((b) => b.id === hash);
    if (targetIndex !== -1) switchBusiness(targetIndex);
  }
</script>