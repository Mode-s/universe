---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
---

<BaseLayout title="お問い合わせ | 株式会社Universe" description="株式会社Universeへのお問い合わせページです。メール・LINE・Instagramにてお気軽にご連絡ください。" headerTheme="light">
  <section class="contact-page">
    <div class="inner">
      <div class="fade-in">
        <SectionTitle titleJa="お問い合わせ" titleEn="CONTACT" />
      </div>
      <p class="contact-lead fade-in">
        株式会社Universe（ユニバース）に関するお問い合わせは、下記いずれかの方法よりご連絡ください。<br />
        送付いただいた内容を確認の上、担当者からご連絡させていただきます。
      </p>
      <ul class="contact-list">
        <li class="contact-item fade-in">
          <a href="mailto:universe.inc42@gmail.com" class="contact-link" aria-label="メールでお問い合わせ">
            <div class="contact-icon-wrap" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#c8a96e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="M2 7l10 7 10-7" />
              </svg>
            </div>
            <div class="contact-body">
              <span class="contact-label">EMAIL</span>
              <span class="contact-value">universe.inc42@gmail.com</span>
            </div>
            <span class="contact-arrow" aria-hidden="true">→</span>
          </a>
        </li>
        <li class="contact-item fade-in">
          <a href="https://line.me/R/ti/p/@162rlyll?oat_content=url&ts=04070112" target="_blank" rel="noopener noreferrer" class="contact-link" aria-label="LINEでお問い合わせ（新しいタブで開きます）">
            <div class="contact-icon-wrap" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <path d="M12 2C6.477 2 2 6.145 2 11.243c0 3.131 1.648 5.908 4.2 7.629V21l2.467-1.357A11.1 11.1 0 0012 20c5.523 0 10-4.144 10-9.243S17.523 2 12 2z" fill="#c8a96e"/>
                <rect x="7" y="10" width="2.2" height="2.2" rx="0.4" fill="#fff" />
                <rect x="10.9" y="10" width="2.2" height="2.2" rx="0.4" fill="#fff" />
                <rect x="14.8" y="10" width="2.2" height="2.2" rx="0.4" fill="#fff" />
              </svg>
            </div>
            <div class="contact-body">
              <span class="contact-label">LINE</span>
              <span class="contact-value">LINEでお問い合わせ</span>
            </div>
            <span class="contact-arrow" aria-hidden="true">→</span>
          </a>
        </li>
        <li class="contact-item fade-in">
          <a href="https://www.instagram.com/inc.universe?igsh=MTRhaXYwbTdyY3R2cQ%3D%3D&utm_source=qr" target="_blank" rel="noopener noreferrer" class="contact-link" aria-label="Instagramでお問い合わせ（新しいタブで開きます）">
            <div class="contact-icon-wrap" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#c8a96e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" fill="#c8a96e" stroke="none" />
              </svg>
            </div>
            <div class="contact-body">
              <span class="contact-label">INSTAGRAM</span>
              <span class="contact-value">@inc.universe</span>
            </div>
            <span class="contact-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .contact-page {
    padding: 120px 0 30px;

    @include sp {
      padding: 80px 0 40px;
    }
  }

  .contact-lead {
    margin-top: 40px;
    font-size: $font-size-sm;
    line-height: 2;
    letter-spacing: 0.06em;
    color: rgba($color-primary, 0.55);

    @include sp {
      font-size: $font-size-xs;
      margin-top: 32px;
    }
  }

  .br-pc {
    @include sp {
      display: none;
    }
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin-top: 56px;

    @include sp {
      margin-top: 36px;
    }
  }

  .contact-item {
    border-top: 0.5px solid rgba($color-primary, 0.12);

    &:last-child {
      border-bottom: 0.5px solid rgba($color-primary, 0.12);
    }
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 20px 12px;
    border-radius: 4px;
    transition: background 0.25s ease;

    &:hover {
      background: rgba($color-primary, 0.03);

      .contact-arrow {
        color: $color-accent;
        transform: translateX(4px);
      }
    }

    @include reduced-motion {
      transition: none;

      &:hover .contact-arrow {
        transform: none;
      }
    }

    @include sp {
      gap: 14px;
      padding: 18px 8px;
    }
  }

  .contact-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;

    @include sp {
      width: 40px;
      height: 40px;

      svg {
        width: 18px;
        height: 18px;
      }
    }
  }

  .contact-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .contact-label {
    font-size: $font-size-xs;
    letter-spacing: 0.2em;
    color: $color-accent;
  }

  .contact-value {
    font-size: $font-size-base;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: $color-primary;
    word-break: break-all;

    @include sp {
      font-size: $font-size-sm;
    }
  }

  .contact-arrow {
    font-size: $font-size-base;
    color: rgba($color-primary, 0.25);
    flex-shrink: 0;
    transition: color 0.25s ease, transform 0.25s ease;

    @include reduced-motion {
      transition: none;
    }
  }
</style>

<script>
  const fadeTargets = document.querySelectorAll<HTMLElement>('.fade-in');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.2 });

  document.querySelectorAll<HTMLElement>('.contact-item').forEach((item, i) => {
    item.style.setProperty('--delay', `${i * 0.1}s`);
  });

  fadeTargets.forEach((el) => observer.observe(el));
</script>