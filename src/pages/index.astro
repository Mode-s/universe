---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero.jpg';
import aboutImage from '../assets/images/photo14.jpg';
import { businesses } from '../data/businesses';
import recruitImage from '../assets/images/photo14.jpg';
import contactImage from '../assets/images/photo14.jpg';
---

<BaseLayout title="株式会社Universe | TOP" description="株式会社Universeのトップページ">
  <section class="hero" slot="hero">
    <div class="image">
      <Image src={heroImage} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="inner">
      <h1 class="title" id="heroTitle">選べる人生を、すべての人に。</h1>
    </div>
    <div class="scroll">
      <div class="wrap">
        <span class="line"></span>
        <span class="text">SCROLL</span>
      </div>
    </div>
  </section>
  <section class="section about">
    <div class="bg-text" aria-hidden="true">ABOUT ABOUT</div>
    <div class="inner">
      <div class="fade-in">
        <SectionTitle titleJa="私たちについて" titleEn="ABOUT" />
      </div>
      <div class="content">
        <div class="text-area">
          <p class="lead fade-in">「選べる」を支える、すべての仕事を。</p>
          <p class="body fade-in">株式会社Universeは、人材・キャリア支援を起点に、コンサルティング・営業代行・広告マーケティングまで、企業と人の可能性を広げる事業を展開しています。</p>
          <p class="body fade-in">「選べる人生を、すべての人に。」<br />この理念のもと、一人ひとりが自分らしい選択をできる社会の実現を目指します。</p>
          <a href="/about" class="view-more" data-astro-prefetch>
            <span class="text">VIEW MORE</span>
            <span class="line" aria-hidden="true"></span>
          </a>
        </div>
        <figure class="image-area fade-in">
          <Image src={aboutImage} alt="" widths={[480, 960]} sizes="(max-width: 768px) 100vw, 480px" />
        </figure>
      </div>
    </div>
  </section>
  <section class="section business">
    <div class="bg-text" aria-hidden="true">BUSINESS</div>
    <div class="inner">
      <div class="fade-in">
        <SectionTitle titleJa="事業内容" titleEn="BUSINESS" />
      </div>
      <div class="layout">
        <div class="image-panel" aria-hidden="true">
          <div class="image-slot">
            <figure class="image-bg is-active" data-index="-1" >
              <Image src={aboutImage} alt="" widths={[640, 960]} sizes="40vw" loading="lazy" />
            </figure>
            {businesses.map((business, index) => (
              <figure class="image-bg" data-index={index}>
                <Image src={business.image} alt="" widths={[640, 960]} sizes="40vw" loading="lazy" />
              </figure>
            ))}
            <div class="image-overlay"></div>
            <div class="image-caption" id="businessCaption">
              <span class="caption-num" id="captionNum"></span>
              <span class="caption-title" id="captionTitle"></span>
            </div>
          </div>
        </div>
        <ul class="list">
          {businesses.map((business, index) => (
            <li class="item fade-in" data-index={index}>
              <a href={`/business#${business.id}`} class="link" data-astro-prefetch>
                <span class="num" aria-hiddenh="true">{business.number}</span>
                <div class="body">
                  <div class="titles">
                    <h3 class="title-ja">{business.titleJa}</h3>
                    <span class="title-en">{business.titleEn}</span>
                  </div>
                  <p class="description">{business.description}</p>
                </div>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
  <section class="section recruit">
    <div class="bg-text" aria-hidden="true">RECRUIT</div>
    <div class="inner">
      <div class="fade-in">
        <SectionTitle titleJa="採用情報" titleEn="RECRUIT" />
      </div>
      <div class="recruit-card fade-in">
        <div class="recruit-card-main">
          <p class="recruit-catch">成長する自分に、出会える場所。</p>
          <p class="recruit-desc">未経験からでも、独自のカリキュラムとメンター制度で着実にステップアップ。<br />あなたの挑戦を、全力で支えます。</p>
        </div>
        <div class="recruit-card-foot">
          <a href="/recruit" class="recruit-link" data-astro-prefetch>
            <span class="recruit-link-line" aria-hidden="true"></span>
            <span class="recruit-link-text">VIEW MORE</span>
            <span class="recruit-link-line" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <section class="section contact">
    <div class="bg-text" aria-hidden="true">CONTACT</div>
    <div class="inner">
      <div class="fade-in">
        <SectionTitle titleJa="お問い合わせ" titleEn="CONTACT" />
      </div>
      <div class="contact-card fade-in">
        <div class="contact-card-body">
          <p class="contact-desc">ご質問・ご相談はお気軽にどうぞ。<br />まずはお気軽にご連絡ください。</p>
          <a href="/contact" class="contact-button" data-astro-prefetch>お問い合わせはこちら</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    height: 100vh;
    color: $color-text-light;
  }

  .hero .image {
    position: absolute;
    inset: 0;
    z-index: 0;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .hero .image::after {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    content: '';
  }

  .hero .inner {
    position: relative;
    z-index: $z-base;
  }

  .hero .title {
    font-size: $font-size-3xl;
    letter-spacing: 0.1em;
    line-height: 1.6;
    opacity: 0;

    &.is-visible {
      animation: fadeup 1s ease forwards;
    }

    @include reduced-motion {
      animation: none;
      opacity: 1;
    }

    @include sp {
      font-size: $font-size-xl;
    }
  }

  @keyframes fadeup {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero .scroll {
    position: absolute;
    bottom: 40px;
    right: 6%;
    z-index: $z-base;
  }

  .hero .scroll .wrap {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    animation: float 2s ease-in-out infinite;
  }

  .hero .scroll .line {
    position: relative;
    display: block;
    width: 0.5px;
    height: 150px;
    background: $color-text-light;

    @include reduced-motion {
      animation: none;
    }

    @include sp {
      height: 100px;
    }

    &::after {
      position: absolute;
      bottom: 0;
      left: 1px;
      display: block;
      width: 40px;
      height: 40px;
      border-bottom: 1.3px solid $color-text-light;
      transform: rotate(-70deg);
      transform-origin: bottom left;
      content: '';
    }
  }

  .hero .scroll .text {
    font-size: $font-size-scroll;
    letter-spacing: 0.7em;
    writing-mode: vertical-rl;

    @include sp {
      letter-spacing: 0.3em;
    }
  }

  @keyframes float {
    0% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(10px);
    }
    100% {
      transform: translateY(0);
    }
  }

  // about

  .about {
    position: relative;
    padding: 120px 0;
    overflow: hidden;

    @include sp {
      padding: 80px 0;
    }
  }

  .bg-text {
    position: absolute;
    bottom: 40px;
    left: 0;
    width: max-content;
    font-size: 14rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.1em;
    color: rgba($color-primary, 0.06);
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
    will-change: transform;

    @include sp {
      bottom: 20px;
      font-size: 6rem;
    }
  }

  .about .content {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 40px;
    align-items: center;
    margin-top: 30px;

    @include sp {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }

  .about .lead {
    font-size: $font-size-lg;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0.05em;

    @include sp {
      font-size: $font-size-base;
    }
  }

  .about .body {
    margin-top: 24px;
    line-height: 1.9;
    letter-spacing: 0.05em;
  }

  .about .view-more {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
    transition: transform 0.3s ease;

    .text {
      font-size: $font-size-xs;
      letter-spacing: 0.2em;
      font-weight: 500;
    }

    .line {
      display: block;
      width: 40px;
      height: 1px;
      background: $color-text;
      transition: width 0.3s ease;
    }

    &:hover {
      transform: translateX(5px);

      .line {
        width: 60px;
      }
    }

    @include reduced-motion {
      transition: none;

      .line {
        transition: none;
      }

      &:hover {
        transform: none;

        .line {
           width: 40px;
        }
      }
    }
  }

  .about .image-area {
    position: relative;

    img {
      position: relative;
      display: block;
      width: 100%;
      height: auto;
      border-radius: 5px;
      object-fit: cover;
      z-index: $z-base;
      will-change: transform;

      @include sp {
        aspect-ratio: 4/2;
        height: auto;
      }
    }

    &::after {
      position: absolute;
      top: 16px;
      right: -16px;
      width: 100%;
      height: 100%;
      border-radius: 5px;
      background: $color-accent;
      content: '';

      @include sp {
        top: 12px;
        right: -12px;
      }
    }
  }

  .about .fade-in:nth-child(2) {
    transition-delay: 0.1s;
  }

  .about .fade-in:nth-child(3) {
    transition-delay: 0.2s;
  }

  .about .fade-in:nth-child(4) {
    transition-delay: 0.3s;
  }


// business


.business {
  position: relative;
  padding: 80px 0 120px;
  background: $color-bg-alt;
  overflow: hidden; 

  @include sp {
    padding: 60px 0 80px;
  }
}

.business .layout {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 60px;
  align-items: start;
  margin-top: 40px;

  @include sp {
    grid-template-columns: 1fr;
    gap: 0;
  }
}

.business .image-panel {
  position: sticky;
  top: 120px;

  @include sp {
    display: none;
  }
}

.business .image-slot {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 4;
  border-radius: 5px;
  overflow: hidden;
  background: $color-bg;
}

.business .image-bg {
  position: absolute;
  inset: 0;
  margin: 0;
  opacity: 0;
  transition: opacity 0.5s ease;

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  &.is-active {
    opacity: 1;
  }

  @include reduced-motion {
    transition: none;
  }
}

.business .image-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.3);
  pointer-events: none;
}

.business .image-caption {
  position: absolute;
  bottom: 20px;
  left: 20px;
  right: 20px;
  z-index: $z-base;display: flex;
  flex-direction: column;
  gap: 4px;
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.35s ease, transform 0.35s wase;
  pointer-events: none;

  &.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @include reduced-motion {
    transition: none;
    transform: none;
  }
}

.business .caption-num {
  font-size: $font-size-xs;
  font-weight: 500;
  letter-spacing: 0.15em;
  color: $color-accent;
}

.business .caption-title {
  font-size: $font-size-base;
  font-weight: 500;
  color: $color-text-light;
  letter-spacing: 0.05em;
}

.business .list {
  list-style: none;
  padding: 0;
}

.business .item {
  border-top: 0.5px solid rgba($color-primary, 0.15);

  &:last-child {
    border-bottom: 0.5px solid rgba($color-primary, 0.15);
  }
}

.business .link {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 24px 12px;
  border-radius: 4px;
  transition: background 0.25s ease;

  &:hover {
    background: rgba($color-primary, 0.04);

    .num {
      color: $color-accent;
    }

    .arrow {
      color: $color-accent;transform: translateY(4px);
    }
  }

  @include reduced-motion {
    transition: none;

    &:hover .business .arrow {
      transform: none;
    }
  }

  @include sp {
    padding: 20px 8px;
    gap: 12px;
  }
}

.business .num {
  font-size: $font-size-3xl;
  font-weight: 500;
  letter-spacing: 0.05em;
  color: rgba($color-primary, 0.15);
  line-height: 1;
  flex-shrink: 0;
  padding-top: 4px;
  transition: color 0.25s ease;
  min-width: 72px;

  @include reduced-motion {
    transition: none;
  }

  @include sp {
    font-size: $font-size-xl;
    min-width: 48px;
  }
}

.business .body {
  flex: 1;
}

.business .titles {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.business .title-ja {
  font-size: $font-size-lg;
  font-weight: 500;
  letter-spacing: 0.05em;
  line-height: 1.4;

  @include sp {
    font-size: $font-size-base;
  }
}

.business .title-en {
  font-size: $font-size-xs;
  letter-spacing: 0.2em;
  color: $color-accent;
}

.business .description {
  margin-top: 10px;
  font-size: $font-size-sm;
  line-height: 1.8;
  letter-spacing: 0.04em;
  color: rgba($color-primary, 0.6);
}

.business .arrow {
  font-size: $font-size-base;
  color: rgba($color-primary, 0.3);
  flex-shrink: 0;
  padding-top: 6px;
  transition: color 0.25s ease, transform 0.25s ease;

  @include reduced-motion {
    transition: none;
  }
}


// recruit

.recruit {
  position: relative;
  padding: 100px 0 120px;
  background: #0c0c0c;
  overflow: hidden; 

  .bg-text {
    color: rgba(255, 255, 255, 0.04);  // ダーク背景用に上書き
  }

  @include sp {
    padding: 60px 0 80px;
  }

  // SectionTitle の色をダーク背景用に上書き
  :global(.title-ja) {
    color: #fff;
  }

  :global(.title-en) {
    color: rgba(255, 255, 255, 0.35);

    &::before,
    &::after {
      background: rgba(255, 255, 255, 0.35);
    }
  }
}

.recruit-card {
  margin-top: 32px;
  border: 0.5px solid rgba(255, 255, 255, 0.07);
  border-radius: 4px;
  overflow: hidden;
}

.recruit-card-main {
  padding: 32px 32px 28px;

  @include sp {
    padding: 24px 20px;
  }
}

.recruit-catch {
  font-size: $font-size-xl;
  font-weight: 500;
  color: $color-text-light;
  line-height: 1.6;
  letter-spacing: 0.04em;

  @include sp {
    font-size: $font-size-lg;
  }
}

.recruit-desc {
  margin-top: 16px;
  font-size: $font-size-sm;
  color: rgba(255, 255, 255, 0.35);
  line-height: 1.9;
  letter-spacing: 0.06em;

  @include sp {
    font-size: $font-size-xs;
  }
}

.recruit-card-foot {
  border-top: 3px solid $color-accent;
  padding: 16px 32px;
  display: flex;
  justify-content: flex-end;

  @include sp {
    padding: 14px 20px;
  }
}

.recruit-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: $color-accent;
  transition: gap 0.3s ease;

  &:hover {
    gap: 16px;
  }

  @include reduced-motion {
    transition: none;

    &:hover {
      gap: 10px;
    }
  }
}

.recruit-link-line {
  display: block;
  width: 24px;
  height: 0.5px;
  background: $color-accent;
  transition: width 0.3s ease;

  .recruit-link:hover & {
    width: 36px;
  }

  @include reduced-motion {
    transition: none;

    .recruit-link:hover & {
      width: 24px;
    }
  }
}

.recruit-link-text {
  font-size: $font-size-xs;
  letter-spacing: 0.3em;
  font-weight: 500;
}

// contact

.contact {
  position: relative;
  padding: 100px 0 120px;
  background: #fafaf8;
  overflow: hidden;

  @include sp {
    padding: 60px 0 80px;
  }
}

.contact-card {
  margin-top: 32px;
  overflow: hidden;
}

.contact-card-body {
  padding: 28px 32px;
  text-align: center;

  @include sp {
    padding: 24px 20px;
  }
}

.contact-desc {
  font-size: $font-size-sm;
  color: rgba($color-primary, 0.5);
  line-height: 1.9;
  letter-spacing: 0.06em;
}

.contact-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 24px;
  padding: 12px 40px;
  border: 0.5px solid $color-primary;
  border-radius: 50px;
  color: $color-primary;
  font-size: $font-size-xs;
  letter-spacing: 0.25em;
  transition: background 0.3s ease, color 0.3s ease;

  &:hover {
    background: $color-primary;
    color: $color-text-light;
  }

  @include reduced-motion {
    transition: none;
  }

  @include sp {
    padding: 11px 32px;
  }
}
</style>

<script>
  const heroTitle = document.getElementById('heroTitle');

  const triggerAnimation = () => {
    if (document.visibilityState === 'hidden') {
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          heroTitle?.classList.add('is-visible');
        }
      }, { once: true });
      return;
    }

    heroTitle?.classList.add('is-visible');
  };

  if (sessionStorage.getItem('loaded')) {
    triggerAnimation();
  } else {
    window.addEventListener('load', () => {
      setTimeout(() => {
        triggerAnimation();
      }, 2600);
    });
  }

  const fadeTargets = document.querySelectorAll('.fade-in');

  const fadeObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        fadeObserver.unobserve(entry.target);
      }
    });
  }, {
    threshold: 0.3,
  });

  fadeTargets.forEach((el) => fadeObserver.observe(el));

  const bgTexts = document.querySelectorAll<HTMLElement>('.bg-text');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (bgTexts && !prefersReducedMotion) {
    let bgTicking = false;

    const updateBgTexts = () => {
    bgTexts.forEach((bgText) => {
      const section = bgText.closest('section') as HTMLElement | null;
      if (!section) return;
      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      if (rect.bottom < 0 || rect.top > windowHeight) return;
      const offset = (rect.top + rect.height / 2 - windowHeight / 2) * 1.5;
      bgText.style.transform = `translateY(${offset}px)`;
    });
    bgTicking = false;
  };

    window.addEventListener('scroll', () => {
      if (!bgTicking) {
        requestAnimationFrame(updateBgTexts);
        bgTicking = true;
      }
    });
    
    updateBgTexts();
  }

  const aboutSection = document.querySelector('.about');
  const aboutImage = document.querySelector('.about .image-area img') as HTMLElement | null;

  if (aboutSection && aboutImage && !prefersReducedMotion) {
    let parallaxTicking = false;

    const updateParallax = () => {

      if (window.innerWidth <= 768) {
        aboutImage.style.transform = '';
        parallaxTicking = false;
        return;
      }
      const rect = aboutSection.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      if (rect.bottom >= 0 && rect.top <= windowHeight) {
        const sectionCenter = rect.top + rect.height / 2;
        const windowCenter = windowHeight / 2;
        const offset = (sectionCenter - windowCenter) * -0.15;

        aboutImage.style.transform = `translateY(${offset}px)`;
      }

      parallaxTicking = false;
    };

    window.addEventListener('scroll', () => {
      if (!parallaxTicking) {
        requestAnimationFrame(updateParallax);
        parallaxTicking = true;
      }
    });

    updateParallax();
  }

  const businessItems = document.querySelectorAll<HTMLElement>('.business .item');
  const imageBgs = document.querySelectorAll<HTMLElement>('.business .image-bg');
  const caption = document.getElementById('businessCaption');
  const captionNum = document.getElementById('captionNum');
  const captionTitle = document.getElementById('captionTitle');

  if (businessItems.length > 0 && imageBgs.length > 0) {
    const showDefault = () => {
      imageBgs.forEach((bg) => {
        bg.classList.toggle('is-active', bg.dataset.index === '-1');
      });
      caption?.classList.remove('is-visible');
    };

    const showBusiness = (index: number, titleJa: string, number: string) => {
      imageBgs.forEach((bg) => {
        bg.classList.toggle('is-active', Number(bg.dataset.index) === index);
      });
      if (captionNum) captionNum.textContent = number;
      if (captionTitle) captionTitle.textContent = titleJa;
      caption?.classList.add('is-visible');
    };

    businessItems.forEach((item) => {
      const index = Number(item.dataset.index);
      const titleJa = item.querySelector<HTMLElement>('.business .title-ja')?.textContent ?? '';
      const number = item.querySelector<HTMLElement>('.business .num')?.textContent ?? '';

        item.addEventListener('mouseenter', () => showBusiness(index, titleJa, number));
        item.addEventListener('mouseleave', showDefault);
    });
  }
</script>