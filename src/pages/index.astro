---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
---

<BaseLayout title="株式会社Universe | TOP" description="株式会社Universeのトップページ">
  <section class="hero" slot="hero">
    <div class="inner">
      <h1 class="title" id="heroTitle">選べる人生を、すべての人に。</h1>
    </div>
    <div class="scroll">
      <div class="wrap">
        <span class="line"></span>
        <span class="text">SCROLL</span>
      </div>
    </div>
  </section>
  <section class="section about">
    <div class="inner">
      <SectionTitle titleJa="私たちについて" titleEN="ABOUT" />
    </div>
  </section>
  <section class="section business">
    <div class="inner">
      <SectionTitle titleJa="事業内容" titleEN="BUSINESS" />
    </div>
  </section>
  <section class="section recruit">
    <div class="inner">
      <SectionTitle titleJa="採用情報" titleEN="RECRUIT" />
    </div>
  </section>
  <section class="section contact">
    <div class="inner">
      <SectionTitle titleJa="お問い合わせ" titleEN="CONTACT" />
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    height: 100vh;
    background: url('/src/assets/images/hero.jpg') center / cover no-repeat;
    color: $color-text-light;
  }

  .hero::after {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    content: '';
  }

  .hero .inner {
    position: relative;
    z-index: $z-base;
  }

  .hero .title {
    font-size: 2.5rem;
    letter-spacing: 0.1em;
    line-height: 1.6;
    opacity: 0;

    &.is-visible {
      animation: fadeup 1s ease forwards;
    }

    @include reduced-motion {
      animation: none;
      opacity: 1;
    }

    @include sp {
      font-size: 1.5rem;
    }
  }

  @keyframes fadeup {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero .scroll {
    position: absolute;
    bottom: 40px;
    right: 6%;
    z-index: $z-base;
  }

  .hero .scroll .wrap {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    animation: float 2s ease-in-out infinite;
  }

  .hero .scroll .line {
    position: relative;
    display: block;
    width: 0.5px;
    height: 150px;
    background: $color-text-light;

    @include reduced-motion {
      animation: none;
    }

    @include sp {
      height: 100px;
    }

    &::after {
      position: absolute;
      bottom: 0;
      left: 1px;
      display: block;
      width: 40px;
      height: 40px;
      border-bottom: 1.3px solid $color-text-light;
      transform: rotate(-70deg);
      transform-origin: bottom left;
      content: '';
    }
  }

  .hero .scroll .text {
    font-size: 0.625rem;
    letter-spacing: 0.7em;
    writing-mode: vertical-rl;

    @include sp {
      letter-spacing: 0.3em;
    }
  }

  @keyframes float {
    0% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(10px);
    }
    100% {
      transform: translateY(0);
    }
  }
</style>

<script>
  const heroTitle = document.getElementById('heroTitle');

  const triggerAnimation = () => {
    if (document.visibilityState === 'hidden') {
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          heroTitle?.classList.add('is-visible');
        }
      }, { once: true });
      return;
    }

    heroTitle?.classList.add('is-visible');
  };

  if (sessionStorage.getItem('loaded')) {
    triggerAnimation();
  } else {
    window.addEventListener('load', () => {
      setTimeout(() => {
        triggerAnimation();
      }, 2600);
    });
  }
</script>