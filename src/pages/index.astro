---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero.jpg';
import aboutImage from '../assets/images/photo14.jpg';
import { businesses } from '../data/businesses';
---

<BaseLayout title="株式会社Universe | TOP" description="株式会社Universeのトップページ">
  <section class="hero" slot="hero">
    <div class="image">
      <Image src={heroImage} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="inner">
      <h1 class="title" id="heroTitle">選べる人生を、すべての人に。</h1>
    </div>
    <div class="scroll">
      <div class="wrap">
        <span class="line"></span>
        <span class="text">SCROLL</span>
      </div>
    </div>
  </section>
  <section class="section about">
    <div class="bg-text" aria-hidden="true">ABOUT ABOUT</div>
    <div class="inner">
      <div class="fade-in">
        <SectionTitle titleJa="私たちについて" titleEn="ABOUT" />
      </div>
      <div class="content">
        <div class="text-area">
          <p class="lead fade-in">「選べる」を支える、すべての仕事を。</p>
          <p class="body fade-in">株式会社Universeは、人材・キャリア支援を起点に、コンサルティング・営業代行・広告マーケティングまで、企業と人の可能性を広げる事業を展開しています。</p>
          <p class="body fade-in">「選べる人生を、すべての人に。」<br />この理念のもと、一人ひとりが自分らしい選択をできる社会の実現を目指します。</p>
          <a href="/about" class="view-more" data-astro-prefetch>
            <span class="text">VIEW MORE</span>
            <span class="line" aria-hidden="true"></span>
          </a>
        </div>
        <figure class="image-area fade-in">
          <Image src={aboutImage} alt="" widths={[480, 960]} sizes="(max-width: 768px) 100vw, 480px" />
        </figure>
      </div>
    </div>
  </section>
  <section class="section business">
    <div class="sticky-container">
      <div class="header">
        <div class="inner">
          <div class="fade-in">
            <SectionTitle titleJa="事業内容" titleEn="BUSINESS" />
          </div>
        </div>
      </div>
      <div class="list">
        {businesses.map((business, index) => (
          <article class="item" data-index={index}>
            <figure class="image-area">
              <Image
                src={business.image}
                alt=""
                widths={[768, 1280, 1920]}
                sizes="100vw"
              />
            </figure>
            <div class="content">
              <span class="number" aria-hidden="true">{business.number}</span>
              <div class="text-area">
                <h3 class="title">
                  <span class="title-ja">{business.titleJa}</span>
                  <span class="title-en">{business.titleEn}</span>
                </h3>
                <p class="catchphrase">{business.catchphrase}</p>
                <p class="description">{business.description}</p>
              </div>
              <a href={`/business#${business.id}`} class="view-more" data-astro-prefetch>
                <span class="text">VIEW MORE</span>
                <span class="line" aria-hidden="true"></span>
              </a>
            </div>
          </article>
        ))}
      </div>
      <div class="indicator" aria-hidden="true">
        {businesses.map((business, index) => (
          <span class="dot" data-index={index}></span>
        ))}
      </div>
    </div>
  </section>
  <section class="section recruit">
    <div class="inner">
      <SectionTitle titleJa="採用情報" titleEn="RECRUIT" />
    </div>
  </section>
  <section class="section contact">
    <div class="inner">
      <SectionTitle titleJa="お問い合わせ" titleEn="CONTACT" />
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    height: 100vh;
    color: $color-text-light;
  }

  .hero .image {
    position: absolute;
    inset: 0;
    z-index: 0;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .hero .image::after {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    content: '';
  }

  .hero .inner {
    position: relative;
    z-index: $z-base;
  }

  .hero .title {
    font-size: $font-size-3xl;
    letter-spacing: 0.1em;
    line-height: 1.6;
    opacity: 0;

    &.is-visible {
      animation: fadeup 1s ease forwards;
    }

    @include reduced-motion {
      animation: none;
      opacity: 1;
    }

    @include sp {
      font-size: $font-size-xl;
    }
  }

  @keyframes fadeup {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero .scroll {
    position: absolute;
    bottom: 40px;
    right: 6%;
    z-index: $z-base;
  }

  .hero .scroll .wrap {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    animation: float 2s ease-in-out infinite;
  }

  .hero .scroll .line {
    position: relative;
    display: block;
    width: 0.5px;
    height: 150px;
    background: $color-text-light;

    @include reduced-motion {
      animation: none;
    }

    @include sp {
      height: 100px;
    }

    &::after {
      position: absolute;
      bottom: 0;
      left: 1px;
      display: block;
      width: 40px;
      height: 40px;
      border-bottom: 1.3px solid $color-text-light;
      transform: rotate(-70deg);
      transform-origin: bottom left;
      content: '';
    }
  }

  .hero .scroll .text {
    font-size: $font-size-scroll;
    letter-spacing: 0.7em;
    writing-mode: vertical-rl;

    @include sp {
      letter-spacing: 0.3em;
    }
  }

  @keyframes float {
    0% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(10px);
    }
    100% {
      transform: translateY(0);
    }
  }

  // about

  .about {
    position: relative;
    padding: 120px 0;
    overflow: hidden;

    @include sp {
      padding: 80px 0;
    }
  }

  .about .bg-text {
    position: absolute;
    bottom: 40px;
    left: 0;
    width: max-content;
    font-size: 14rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.1em;
    color: rgba($color-primary, 0.06);
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
    will-change: transform;

    @include sp {
      bottom: 20px;
      font-size: 6rem;
    }
  }

  .about .content {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 40px;
    align-items: center;
    margin-top: 30px;

    @include sp {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }

  .about .lead {
    font-size: $font-size-lg;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0.05em;

    @include sp {
      font-size: $font-size-base;
    }
  }

  .about .body {
    margin-top: 24px;
    line-height: 1.9;
    letter-spacing: 0.05em;
  }

  .about .view-more {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
    transition: transform 0.3s ease;

    .text {
      font-size: $font-size-xs;
      letter-spacing: 0.2em;
      font-weight: 500;
    }

    .line {
      display: block;
      width: 40px;
      height: 1px;
      background: $color-text;
      transition: width 0.3s ease;
    }

    &:hover {
      transform: translateX(5px);

      .line {
        width: 60px;
      }
    }

    @include reduced-motion {
      transition: none;

      .line {
        transition: none;
      }

      &:hover {
        transform: none;

        .line {
           width: 40px;
        }
      }
    }
  }

  .about .image-area {
    position: relative;

    img {
      position: relative;
      display: block;
      width: 100%;
      height: auto;
      border-radius: 5px;
      object-fit: cover;
      z-index: $z-base;
      will-change: transform;

      @include sp {
        aspect-ratio: 4/2;
        height: auto;
      }
    }

    &::after {
      position: absolute;
      top: 16px;
      right: -16px;
      width: 100%;
      height: 100%;
      border-radius: 5px;
      background: $color-accent;
      content: '';

      @include sp {
        top: 12px;
        right: -12px;
      }
    }
  }

  .about .fade-in {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;

    &.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    @include reduced-motion {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .about .fade-in:nth-child(2) {
    transition-delay: 0.1s;
  }

  .about .fade-in:nth-child(3) {
    transition-delay: 0.2s;
  }

  .about .fade-in:nth-child(4) {
    transition-delay: 0.3s;
  }

// business

// business

.business {
  position: relative;
  height: 100vh;
  background: $color-bg-alt;
}

.business .sticky-container {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
}

.business .header {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  padding: 80px 0 20px;
  background: linear-gradient(
    to bottom,
    $color-bg-alt 0%,
    $color-bg-alt 70%,
    rgba($color-bg-alt, 0) 100%
  );
}

.business .list {
  position: relative;
  flex: 1;
}

.business .item {
  position: absolute;
  inset: 0;
  color: #fff;
  cursor: pointer;

  /* デフォルト：画面下で待機 */
  transform: translateY(100%);
  opacity: 0;
  z-index: 0;

  /* 現在表示中 */
  &.is-active {
    transform: translateY(0) scale(1);
    opacity: 1;
    z-index: 2;
  }

  /* 退場済み（奥に引っ込んだ） */
  &.is-above {
    transform: translateY(0) scale(0.85);
    opacity: 0;
    z-index: 1;
  }

  /* 画面下で待機中 */
  &.is-below {
    transform: translateY(100%);
    opacity: 0;
    z-index: 0;
  }

  /* アニメーション有効時のみ transition を付ける */
  &.is-animated {
    transition: transform 0.8s ease, opacity 0.8s ease;
  }

  @include reduced-motion {
    transition: none !important;
  }
}

/* 画像（背景として敷く） */
.business .image-area {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  &::after {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    content: '';
  }
}

/* テキストコンテンツ */
.business .content {
  position: relative;
  z-index: $z-base;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  height: 100%;
  max-width: $container-width;
  margin: 0 auto;
  padding: 20px 20px;
}

.business .number {
  position: absolute;
  top: 40px;
  left: 20px;
  font-size: $font-size-3xl;
  font-weight: 500;
  letter-spacing: 0.1em;
  color: $color-accent;
  line-height: 1;
}

.business .text-area {
  max-width: 600px;
}

.business .title {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.business .title-ja {
  font-size: $font-size-xl;
  font-weight: 500;
  letter-spacing: 0.05em;
}

.business .title-en {
  font-size: $font-size-label;
  letter-spacing: 0.2em;
  color: rgba(255, 255, 255, 0.7);
}

.business .catchphrase {
  margin-top: 16px;
  font-size: $font-size-lg;
  font-weight: 500;
  line-height: 1.6;
  letter-spacing: 0.05em;
}

.business .description {
  margin-top: 12px;
  line-height: 1.9;
  letter-spacing: 0.05em;
  color: rgba(255, 255, 255, 0.85);
}

.business .view-more {
  display: inline-flex;
  align-items: center;
  gap: 16px;
  margin-top: 24px;
  color: $color-accent;
  transition: transform 0.3s ease;

  .text {
    font-size: $font-size-xs;
    letter-spacing: 0.2em;
    font-weight: 500;
  }

  .line {
    display: block;
    width: 40px;
    height: 1px;
    background: $color-accent;
    transition: width 0.3s ease;
  }

  &:hover {
    transform: translateX(5px);

    .line {
      width: 60px;
    }
  }

  @include reduced-motion {
    transition: none;

    .line {
      transition: none;
    }

    &:hover {
      transform: none;

      .line {
        width: 40px;
      }
    }
  }
}

.business .indicator {
  position: absolute;
  top: 50%;
  right: 40px;
  z-index: 3;
  display: flex;
  flex-direction: column;
  gap: 16px;
  transform: translateY(-50%);
}

.business .indicator .dot {
  display: block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transition: background 0.3s ease, transform 0.3s ease;

  @include reduced-motion {
    transition: none;
  }

  &.is-active {
    background: $color-accent;
    transform: scale(1.3);
  }
}


  </style>

<script>
  const heroTitle = document.getElementById('heroTitle');

  const triggerAnimation = () => {
    if (document.visibilityState === 'hidden') {
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          heroTitle?.classList.add('is-visible');
        }
      }, { once: true });
      return;
    }

    heroTitle?.classList.add('is-visible');
  };

  if (sessionStorage.getItem('loaded')) {
    triggerAnimation();
  } else {
    window.addEventListener('load', () => {
      setTimeout(() => {
        triggerAnimation();
      }, 2600);
    });
  }

  const fadeTargets = document.querySelectorAll('.about .fade-in');

  const fadeObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        fadeObserver.unobserve(entry.target);
      }
    });
  }, {
    threshold: 0.3,
  });

  fadeTargets.forEach((el) => fadeObserver.observe(el));

  const bgText = document.querySelector('.about .bg-text') as HTMLElement | null;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (bgText && !prefersReducedMotion) {
    let ticking = false;

    const updateBgText = () => {
      const scrollY = window.scrollY;
      bgText.style.transform = `translateY(${-scrollY * 0.7}px)`;
      ticking = false;
    };
  

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateBgText);
        ticking = true;
      }
    });
    
    updateBgText();
  }

  const aboutSection = document.querySelector('.about');
  const aboutImage = document.querySelector('.about .image-area img') as HTMLElement | null;

  if (aboutSection && aboutImage && !prefersReducedMotion) {
    let parallaxTicking = false;

    const updateParallax = () => {

      if (window.innerWidth <= 768) {
        aboutImage.style.transform = '';
        parallaxTicking = false;
        return;
      }
      const rect = aboutSection.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      if (rect.bottom >= 0 && rect.top <= windowHeight) {
        const sectionCenter = rect.top + rect.height / 2;
        const windowCenter = windowHeight / 2;
        const offset = (sectionCenter - windowCenter) * -0.15;

        aboutImage.style.transform = `translateY(${offset}px)`;
      }

      parallaxTicking = false;
    };

    window.addEventListener('scroll', () => {
      if (!parallaxTicking) {
        requestAnimationFrame(updateParallax);
        parallaxTicking = true;
      }
    });

    updateParallax();
  }

/* ─── BUSINESS: スナップスクロール ─── */
const businessSection = document.querySelector('.business') as HTMLElement | null;
const businessItems = document.querySelectorAll<HTMLElement>('.business .item');

if (businessSection && businessItems.length > 0 && !prefersReducedMotion && window.innerWidth > 768) {
  const dots = document.querySelectorAll<HTMLElement>('.business .indicator .dot');
  const totalSlides = businessItems.length;
  let currentSlide = 0;
  let isAnimating = false;
  let isCaptured = false;
  let cooldownActive = false;
  const ANIMATION_DURATION = 800;
  const COOLDOWN_DURATION = 1200;
  const CAPTURE_DELAY = 300;
  const HEADER_SCROLL_OFFSET = 80;
  const EXTRA_SCROLL_DOWN = 40;
  // プログラムで scrollTo 中は scroll 方向の記録や IO を汚染しない
  let isProgrammaticScroll = false;
  // 整列〜capture の二重実行防止
  let isAligning = false;
    // 直近のスクロール方向（止まったあとでもオブザーバーで正しく使う）
  let prevScrollY = window.scrollY;
  let lastScrollWasDown = true; // 未スクロール時は「上から下へ」とみなす

  window.addEventListener('scroll', () => {
    if (isProgrammaticScroll) return;

    const y = window.scrollY;
    if (y > prevScrollY) {
      lastScrollWasDown = true;
    } else if (y < prevScrollY) {
      lastScrollWasDown = false;
    }
    prevScrollY = y;
  }, { passive: true });

  /* スライドの状態を更新（アニメーションあり/なし選択可能） */
  const updateSlides = (animate: boolean) => {
    businessItems.forEach((item, i) => {
      // アニメーションフラグの制御
      if (animate) {
        item.classList.add('is-animated');
      } else {
        item.classList.remove('is-animated');
      }

      // 状態クラスの更新
      item.classList.remove('is-active', 'is-above', 'is-below');
      if (i < currentSlide) {
        item.classList.add('is-above');
      } else if (i === currentSlide) {
        item.classList.add('is-active');
      } else {
        item.classList.add('is-below');
      }
    });

    dots.forEach((dot, i) => {
      dot.classList.toggle('is-active', i === currentSlide);
    });
  };

  /* 初期表示（アニメーションなし） */
  updateSlides(false);

  /* カード全体のクリックで遷移 */
  businessItems.forEach((item) => {
    const link = item.querySelector('.view-more') as HTMLAnchorElement | null;
    if (link) {
      item.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('.view-more')) return;
        window.location.href = link.href;
      });
    }
  });

    /* キャプチャ時に揃えるスクロール位置（マウス／キー共通） */
    const getSnapScrollY = (fromBottom: boolean) => {
    const rect = businessSection.getBoundingClientRect();
    const topAbs = window.scrollY + rect.top;

    if (fromBottom) {
      return Math.max(
        0,
        Math.round(topAbs + businessSection.offsetHeight - window.innerHeight),
      );
    }

    return Math.max(
      0,
      Math.round(topAbs - HEADER_SCROLL_OFFSET + EXTRA_SCROLL_DOWN),
    );
  };

  /* 位置を揃えてからキャプチャ */
  const alignScrollThenCapture = (fromBottom: boolean) => {
    if (isCaptured || cooldownActive || isAnimating || isAligning) return;
    isAligning = true;
    isProgrammaticScroll = true;

    window.scrollTo({
      top: getSnapScrollY(fromBottom),
      left: 0,
      behavior: 'auto',
    });

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        isProgrammaticScroll = false;
        isAligning = false;
        capture(fromBottom);
      });
    });
  };


  /* セクションをキャプチャ */
  const capture = (fromBottom: boolean) => {
    if (isCaptured || cooldownActive) return;
    isCaptured = true;

    // まず位置をスナップ
    document.body.style.overflow = 'hidden';

    // 初期スライドをアニメーションなしで配置
    currentSlide = fromBottom ? totalSlides - 1 : 0;
    updateSlides(false);

    // 少し待ってからアニメーションを有効化（最初のカードを見せる時間）
    isAnimating = true;
    setTimeout(() => {
      isAnimating = false;
    }, CAPTURE_DELAY);
  };

  /* セクションを解放 */
  const release = (direction: 'up' | 'down') => {
    if (!isCaptured) return;
    isCaptured = false;
    cooldownActive = true;
    document.body.style.overflow = '';

    setTimeout(() => {
      cooldownActive = false;
    }, COOLDOWN_DURATION);
  };

  /* IntersectionObserver でセクション検知 */
  const observer = new IntersectionObserver((entries) => {
  entries.forEach((entry) => {
    if (!entry.isIntersecting || isCaptured || cooldownActive || isAnimating || isAligning) return;

    capture(!lastScrollWasDown);
  });
}, {
  threshold: [0.95],
});

observer.observe(businessSection);

  /* ホイール操作でスライド切替 */
  window.addEventListener('wheel', (e) => {
    if (!isCaptured) return;
    e.preventDefault();
    if (isAnimating) return;

    if (e.deltaY > 0) {
      if (currentSlide < totalSlides - 1) {
        isAnimating = true;
        currentSlide++;
        updateSlides(true);  // アニメーション付き
        setTimeout(() => { isAnimating = false; }, ANIMATION_DURATION);
      } else {
        release('down');
      }
    } else if (e.deltaY < 0) {
      if (currentSlide > 0) {
        isAnimating = true;
        currentSlide--;
        updateSlides(true);  // アニメーション付き
        setTimeout(() => { isAnimating = false; }, ANIMATION_DURATION);
      } else {
        release('up');
      }
    }
  }, { passive: false });
}
</script>