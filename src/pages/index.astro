---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero.jpg';
import aboutImage from '../assets/images/photo14.jpg';
import { businesses } from '../data/businesses';
import recruitImage from '../assets/images/photo14.jpg';
import contactImage from '../assets/images/photo14.jpg';
---

<BaseLayout title="株式会社Universe | TOP" description="株式会社Universeのトップページ">
  <section class="hero" slot="hero">
    <div class="image">
      <Image src={heroImage} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="inner">
      <h1 class="title" id="heroTitle">選べる人生を、すべての人に。</h1>
    </div>
    <div class="scroll">
      <div class="wrap">
        <span class="line"></span>
        <span class="text">SCROLL</span>
      </div>
    </div>
  </section>
  <section class="section about">
    <div class="bg-text" aria-hidden="true">ABOUT ABOUT</div>
    <div class="inner">
      <div class="fade-in">
        <SectionTitle titleJa="私たちについて" titleEn="ABOUT" />
      </div>
      <div class="content">
        <div class="text-area">
          <p class="lead fade-in">「選べる」を支える、すべての仕事を。</p>
          <p class="body fade-in">株式会社Universeは、人材・キャリア支援を起点に、コンサルティング・営業代行・広告マーケティングまで、企業と人の可能性を広げる事業を展開しています。</p>
          <p class="body fade-in">「選べる人生を、すべての人に。」<br />この理念のもと、一人ひとりが自分らしい選択をできる社会の実現を目指します。</p>
          <a href="/about" class="view-more" data-astro-prefetch>
            <span class="text">VIEW MORE</span>
            <span class="line" aria-hidden="true"></span>
          </a>
        </div>
        <figure class="image-area fade-in">
          <Image src={aboutImage} alt="" widths={[480, 960]} sizes="(max-width: 768px) 100vw, 480px" />
        </figure>
      </div>
    </div>
  </section>
  <section class="section business">
      <div class="header">
        <div class="inner">
          <div class="fade-in">
            <SectionTitle titleJa="事業内容" titleEn="BUSINESS" />
          </div>
        </div>
      </div>
      <div class="list">
        {businesses.map((business, index) => (
          <article class="item" data-index={index}>
            <figure class="image-area">
              <Image
                src={business.image}
                alt=""
                widths={[768, 1280, 1920]}
                sizes="100vw"
              />
            </figure>
            <div class="content">
              <span class="number" aria-hidden="true">{business.number}</span>
              <div class="text-area">
                <h3 class="title">
                  <span class="title-ja">{business.titleJa}</span>
                  <span class="title-en">{business.titleEn}</span>
                </h3>
                <p class="catchphrase">{business.catchphrase}</p>
                <p class="description">{business.description}</p>
              </div>
              <a href={`/business#${business.id}`} class="view-more" data-astro-prefetch>
                <span class="text">VIEW MORE</span>
                <span class="line" aria-hidden="true"></span>
              </a>
            </div>
          </article>
        ))}
      </div>
  </section>
  <section class="section recruit">
    <figure class="image">
      <Image src={recruitImage} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="lazy" />
    </figure>
    <div class="inner">
      <div class="fade-in">
        <SectionTitle titleJa="採用情報" titleEn="RECRUIT" />
      </div>
      <p class="lead fade-in">成長する自分に出会える場所。</p>
      <p class="body fade-in">未経験からでも、独自の育成カリキュラムとメンター制度で着実にステップアップア。<br />「自分で考えて動ける人材」へ——あなたの挑戦を、全力で支えます。</p>
      <a href="/recruit" class="view-more fade-in" data-astro-preftch>
        <span class="text">VIEW MORE</span>
        <span class="line" aria-hidden="true"></span>
      </a>
    </div>
  </section>
  <section class="section contact">
    <figure class="image">
      <Image src={contactImage} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="lazy" />
    </figure>
    <div class="inner">
      <div class="fade-in">
        <SectionTitle titleJa="お問い合わせ" titleEn="CONTACT" />
      </div>
      <p class="lead fade-in">ご質問・ご相談はお気軽にどうぞ。</p>
      <a href="/contact" class="button fade-in" data-astro-prefetch>お問い合わせはこちら</a>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    height: 100vh;
    color: $color-text-light;
  }

  .hero .image {
    position: absolute;
    inset: 0;
    z-index: 0;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .hero .image::after {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    content: '';
  }

  .hero .inner {
    position: relative;
    z-index: $z-base;
  }

  .hero .title {
    font-size: $font-size-3xl;
    letter-spacing: 0.1em;
    line-height: 1.6;
    opacity: 0;

    &.is-visible {
      animation: fadeup 1s ease forwards;
    }

    @include reduced-motion {
      animation: none;
      opacity: 1;
    }

    @include sp {
      font-size: $font-size-xl;
    }
  }

  @keyframes fadeup {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero .scroll {
    position: absolute;
    bottom: 40px;
    right: 6%;
    z-index: $z-base;
  }

  .hero .scroll .wrap {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    animation: float 2s ease-in-out infinite;
  }

  .hero .scroll .line {
    position: relative;
    display: block;
    width: 0.5px;
    height: 150px;
    background: $color-text-light;

    @include reduced-motion {
      animation: none;
    }

    @include sp {
      height: 100px;
    }

    &::after {
      position: absolute;
      bottom: 0;
      left: 1px;
      display: block;
      width: 40px;
      height: 40px;
      border-bottom: 1.3px solid $color-text-light;
      transform: rotate(-70deg);
      transform-origin: bottom left;
      content: '';
    }
  }

  .hero .scroll .text {
    font-size: $font-size-scroll;
    letter-spacing: 0.7em;
    writing-mode: vertical-rl;

    @include sp {
      letter-spacing: 0.3em;
    }
  }

  @keyframes float {
    0% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(10px);
    }
    100% {
      transform: translateY(0);
    }
  }

  // about

  .about {
    position: relative;
    padding: 120px 0;
    overflow: hidden;

    @include sp {
      padding: 80px 0;
    }
  }

  .about .bg-text {
    position: absolute;
    bottom: 40px;
    left: 0;
    width: max-content;
    font-size: 14rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.1em;
    color: rgba($color-primary, 0.06);
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
    will-change: transform;

    @include sp {
      bottom: 20px;
      font-size: 6rem;
    }
  }

  .about .content {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 40px;
    align-items: center;
    margin-top: 30px;

    @include sp {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }

  .about .lead {
    font-size: $font-size-lg;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0.05em;

    @include sp {
      font-size: $font-size-base;
    }
  }

  .about .body {
    margin-top: 24px;
    line-height: 1.9;
    letter-spacing: 0.05em;
  }

  .about .view-more {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
    transition: transform 0.3s ease;

    .text {
      font-size: $font-size-xs;
      letter-spacing: 0.2em;
      font-weight: 500;
    }

    .line {
      display: block;
      width: 40px;
      height: 1px;
      background: $color-text;
      transition: width 0.3s ease;
    }

    &:hover {
      transform: translateX(5px);

      .line {
        width: 60px;
      }
    }

    @include reduced-motion {
      transition: none;

      .line {
        transition: none;
      }

      &:hover {
        transform: none;

        .line {
           width: 40px;
        }
      }
    }
  }

  .about .image-area {
    position: relative;

    img {
      position: relative;
      display: block;
      width: 100%;
      height: auto;
      border-radius: 5px;
      object-fit: cover;
      z-index: $z-base;
      will-change: transform;

      @include sp {
        aspect-ratio: 4/2;
        height: auto;
      }
    }

    &::after {
      position: absolute;
      top: 16px;
      right: -16px;
      width: 100%;
      height: 100%;
      border-radius: 5px;
      background: $color-accent;
      content: '';

      @include sp {
        top: 12px;
        right: -12px;
      }
    }
  }

  .about .fade-in:nth-child(2) {
    transition-delay: 0.1s;
  }

  .about .fade-in:nth-child(3) {
    transition-delay: 0.2s;
  }

  .about .fade-in:nth-child(4) {
    transition-delay: 0.3s;
  }

